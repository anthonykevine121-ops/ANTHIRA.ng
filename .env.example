# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Supabase project settings for sign-up, email OTP verification, and customer profiles.
# These are public client values. Never expose a secret/service-role key in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="YOUR_SUPABASE_PUBLISHABLE_KEY"

# Set these as Supabase Edge Function secrets, not VITE_* browser variables:
# supabase secrets set APP_ORIGIN="https://your-site.example"
# Optional extra exact origins for local testing, comma-separated:
# supabase secrets set ADDITIONAL_APP_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
# supabase secrets set NOTIFICATION_EMAIL="anthoanthonykevine121@gmail.com"
# supabase secrets set RESEND_API_KEY="YOUR_RESEND_API_KEY"
# supabase secrets set EMAIL_FROM="ANTHIRA <notifications@your-verified-domain.example>"
# supabase secrets set WHATSAPP_RECIPIENT="2349018021688"
# supabase secrets set WHATSAPP_ACCESS_TOKEN="YOUR_META_CLOUD_API_ACCESS_TOKEN"
# supabase secrets set WHATSAPP_PHONE_NUMBER_ID="YOUR_META_PHONE_NUMBER_ID"
# supabase secrets set WHATSAPP_TEMPLATE_NAME="new_website_request"
# supabase secrets set WHATSAPP_TEMPLATE_LANGUAGE="en"
# Create and get Meta approval for a WhatsApp template with six ordered body parameters:
# customer name, customer email, customer phone, service, budget, and project details.
# Suggested template body: "New website request: {{1}} | {{2}} | {{3}} | {{4}} | {{5}} | {{6}}"
# Verify the EMAIL_FROM domain with Resend, configure the approved template in Meta,
# set APP_ORIGIN to the exact deployed site origin (no trailing slash), then deploy with:
# supabase functions deploy notify-quote
